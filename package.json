{
  "name": "@arnowei/pi-remote-workspaces",
  "version": "0.1.0",
  "description": "SSH workspaces for pi and pi-web, powered by your OpenSSH config",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ssh",
    "remote",
    "pi-web"
  ],
  "bin": {
    "pi-remote": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/extension.ts"
  },
  "files": [
    "src",
    "dist",
    "public",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/releasing.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/*.integration.ts",
    "test:pi-web": "PI_REMOTE_TEST_PI_WEB=1 tsx --test test/pi-web.integration.ts",
    "dev": "tsx src/cli.ts serve",
    "prepack": "npm run build",
    "test:package": "node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "author": "Arno Wei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buptweixin/pi-remote-workspaces.git"
  },
  "homepage": "https://github.com/buptweixin/pi-remote-workspaces#readme",
  "bugs": {
    "url": "https://github.com/buptweixin/pi-remote-workspaces/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
